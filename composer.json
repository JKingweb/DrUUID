{
    "name": "jkingweb/druuid",
    "type": "library",
    "description": "DrUUID RFC 9562 library for PHP",
    "keywords": ["uuid"],
    "license": "MIT",
    "authors": [
        {
            "name": "J. King",
            "email": "jking@jkingweb.ca",
            "homepage": "https://jkingweb.ca/"
        }
    ],
    "require": {
        "php": ">=7.1.0"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "*"
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": false,
            "forward-command": true
        }
    },
    "autoload": {
        "psr-4": {
            "JKingWeb\\DrUUID\\": "lib/"
        }
    }
}